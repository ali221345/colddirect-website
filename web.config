        </rewriteMap>
      </rewriteMaps>
      <rules>
        <rule name="Blog stub smeg control panel to commercial fridge hub" stopProcessing="true">
          <match url="^blog/smeg-fridge-freezer-control-panel(?:/index\.html|\.html|\.asp|/)?$" ignoreCase="true" />
          <action type="Redirect" url="https://www.colddirect.co.uk/commercial-fridge-repair-london/" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="Blog stub samsung fridge freezer to commercial freezer hub" stopProcessing="true">
          <match url="^blog/samsung-fridge-freezer-not-freezing(?:/index\.html|\.html|\.asp|/)?$" ignoreCase="true" />
          <action type="Redirect" url="https://www.colddirect.co.uk/commercial-freezer-repair-london/" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="Blog stub cold room troubleshooting to temperature fluctuation article" stopProcessing="true">
          <match url="^blog/cold-room-troubleshooting(?:/index\.html|\.html|\.asp|/)?$" ignoreCase="true" />
          <action type="Redirect" url="https://www.colddirect.co.uk/blog/cold-room-temperature-fluctuation/" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="Blog stub chiller not cooling to chiller repair hub" stopProcessing="true">
          <match url="^blog/chiller-not-cooling(?:/index\.html|\.html|\.asp|/)?$" ignoreCase="true" />
          <action type="Redirect" url="https://www.colddirect.co.uk/chiller-repair-london/" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="About stub to about-us" stopProcessing="true">
          <match url="^about(?:/index\.html|\.html|/)?$" ignoreCase="true" />
          <action type="Redirect" url="https://www.colddirect.co.uk/about-us/" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="Refrigeration brands plural to singular" stopProcessing="true">
          <match url="^refrigeration-brands-repairs-london(?:/index\.html|\.html|\.asp|/)?$" ignoreCase="true" />
          <action type="Redirect" url="https://www.colddirect.co.uk/refrigeration-brands-repair-london/" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="301 legacy asp pages to clean URLs" stopProcessing="true">
          <match url="^([a-z0-9-]+\.asp)$" ignoreCase="true" />
          <conditions>
            <add input="{AspClean:{R:1}}" pattern="(.+)" />
          </conditions>
          <action type="Redirect" url="https://www.colddirect.co.uk{C:1}" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="Legacy news to canonical blog" stopProcessing="true">
          <match url="^news(?:/index\.html|/|\.html)?$" ignoreCase="true" />
          <action type="Redirect" url="https://www.colddirect.co.uk/blog/" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="Consumer ice cream maker blog to commercial ice cream machine repair" stopProcessing="true">
          <match url="^blog/best-ice-cream-makers(?:/index\.html|\.html|\.asp|/)?$" ignoreCase="true" />
          <action type="Redirect" url="https://www.colddirect.co.uk/ice-cream-machine-repair-london/" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="Pass through existing .html files" stopProcessing="true">
          <match url="^.*\.html$" ignoreCase="true" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>
        <rule name="Blog article directory to html" stopProcessing="true">
          <match url="^blog/([a-z0-9-]+)/?$" ignoreCase="true" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="blog/{R:1}.html" />
        </rule>
        <rule name="Blog cost asp to folder" stopProcessing="true">
          <match url="^blog/commercial-fridge-repair-cost-london\.asp$" ignoreCase="true" />
          <action type="Redirect" url="/blog/commercial-fridge-repair-cost-london/" redirectType="Permanent" />
        </rule>
        <rule name="Cold room repairs old page to new page" stopProcessing="true">
          <match url="^cold-room-repairs-london/?$" ignoreCase="true" />
          <action type="Redirect" url="/cold-room-repair-london/" redirectType="Permanent" />
        </rule>
        <rule name="Refrigeration brands asp and plural to html" stopProcessing="true">
          <match url="^refrigeration-brands-repairs?-london(\.asp)?$" ignoreCase="true" />
          <action type="Redirect" url="/refrigeration-brands-repair-london.html" redirectType="Permanent" />
        </rule>
        <rule name="Restored HTML money pages asp to html" stopProcessing="true">
          <match url="^(cabinet-fridge-repair-london|walk-in-fridge-repair-london|walk-in-freezer-repair-london|dairy-cabinet-repair-london|display-fridge-repair-london|hoshizaki-ice-machine-repair-london|cold-storage|blast-freezing|williams-fridge-repair-london)\.asp$" ignoreCase="true" />
          <action type="Redirect" url="/{R:1}.html" redirectType="Permanent" />
        </rule>
        <rule name="Hoshizaki cold-storage blast extensionless to html" stopProcessing="true">
          <match url="^(hoshizaki-ice-machine-repair-london|cold-storage|blast-freezing|cabinet-fridge-repair-london|walk-in-fridge-repair-london|walk-in-freezer-repair-london|dairy-cabinet-repair-london|display-fridge-repair-london)/?$" ignoreCase="true" />
          <action type="Rewrite" url="{R:1}.html" />
        </rule>
        <rule name="Sitemap extensionless" stopProcessing="true">
          <match url="^sitemap/?$" ignoreCase="true" />
          <action type="Rewrite" url="sitemap.xml" />
        </rule>
        <rule name="AC short redirect" stopProcessing="true">
          <match url="^air-conditioning-repair/?$" />
          <action type="Redirect" url="/air-conditioning-repair-london.html" redirectType="Permanent" />
        </rule>
        <rule name="Supermarket short redirect" stopProcessing="true">
          <match url="^supermarket-fridge-repair/?$" />
          <action type="Redirect" url="/supermarket-fridge-repair-london.html" redirectType="Permanent" />
        </rule>
        <rule name="Dead fridge-freezer combo redirect to home" stopProcessing="true">
          <match url="^fridge-freezer-repairs?-london/?$" ignoreCase="true" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="Serve real service directory index" stopProcessing="true">
          <match url="^([a-z0-9-]+)/?$" ignoreCase="true" />
          <conditions>
            <add input="{APPL_PHYSICAL_PATH}{R:1}\index.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}/index.html" />
        </rule>
        <rule name="Brand short plural to full fridge" stopProcessing="false">
          <match url="^([a-z-]+)-repairs-london$" ignoreCase="true" />
          <action type="Rewrite" url="{R:1}-repair-london.asp" />
        </rule>
        <rule name="Ice cream maker to machine redirect" stopProcessing="true">
          <match url="^ice-cream-maker-repairs?-london(/|\.html|\.asp)?$" ignoreCase="true" />
          <action type="Redirect" url="/ice-cream-machine-repair-london/" redirectType="Permanent" />
        </rule>
        <rule name="Fridge repair london to directory" stopProcessing="true">
          <match url="^fridge-repair-london$" ignoreCase="true" />
          <action type="Redirect" url="/fridge-repair-london/" redirectType="Permanent" />
        </rule>
        <rule name="Freezer repair london to directory" stopProcessing="true">
          <match url="^freezer-repair-london$" ignoreCase="true" />
          <action type="Redirect" url="/freezer-repair-london/" redirectType="Permanent" />
        </rule>
        <rule name="Verified public service bare aliases to canonical folders" stopProcessing="true">
          <match url="^(appliances-repair-london|catering-repair-london|chiller-repair-london)$" ignoreCase="true" />
          <action type="Redirect" url="/{R:1}/" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="Verified short cooler aliases to canonical folders" stopProcessing="true">
          <match url="^(bottle-cooler-repair|display-fridge-repair)$" ignoreCase="true" />
          <action type="Redirect" url="/{R:1}-london/" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="Brand repair to fridge-repair" stopProcessing="false">
          <match url="^([a-z]+)-repair-london$" ignoreCase="true" />
          <conditions>
            <add input="{R:1}" pattern="^fridge$" ignoreCase="true" negate="true" />
            <add input="{R:1}" pattern="^freezer$" ignoreCase="true" negate="true" />
          </conditions>
          <action type="Rewrite" url="{R:1}-fridge-repair-london.asp" />
        </rule>
        <rule name="Pass through existing files" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>
        <rule name="William Google aliases" stopProcessing="true">
          <match url="^williams?(-fridge)?-repairs?-london(\.asp)?$" ignoreCase="true" />
          <action type="Redirect" url="/williams-fridge-repair-london.html" redirectType="Permanent" />
        </rule>
        <rule name="Fix repairs plural to repair" stopProcessing="false">
          <match url="^(.*)-repairs-(.*)$" ignoreCase="true" />
          <action type="Rewrite" url="{R:1}-repair-{R:2}" />
        </rule>
        <rule name="ASP Extensionless Root" stopProcessing="true">
          <match url="^([a-z0-9-]+)/?$" ignoreCase="true" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="{R:1}.asp" />
        </rule>
        <rule name="ASP Extensionless Subfolder" stopProcessing="true">
          <match url="^([a-z0-9/-]+?)/?$" ignoreCase="true" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="{R:1}.asp" />
        </rule>
      </rules>
    </rewrite>
    <handlers>
      <remove name="ASPClassic" />
      <add name="ASPClassic" path="*.asp" verb="GET,HEAD,POST" modules="IsapiModule" scriptProcessor="%windir%\system32\inetsrv\asp.dll" resourceType="File" requireAccess="Script" />
    </handlers>
    <security>
      <requestFiltering>
        <fileExtensions>
          <remove fileExtension=".asp" />
          <add fileExtension=".asp" allowed="true" />
          <remove fileExtension=".key" />
          <add fileExtension=".key" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpErrors errorMode="Custom" />
  </system.webServer>
</configuration>
