          <add key="wine-repairs-london" value="/wine-cooler-repair-london.html" />
          <add key="wine-repairs-london.html" value="/wine-cooler-repair-london.html" />
          <add key="wine-repairs-london.asp" value="/wine-cooler-repair-london.html" />
        </rewriteMap>
      </rewriteMaps>
      <rules>
        <rule name="Sitemap extensionless" stopProcessing="true">
          <match url="^sitemap/?$" ignoreCase="true" />
          <action type="Rewrite" url="sitemap.xml" />
        </rule>
        <rule name="AC short redirect" stopProcessing="true">
          <match url="^air-conditioning-repair/?$" />
          <action type="Redirect" url="/air-conditioning-repair-london.html" redirectType="Permanent" />
        </rule>
        <rule name="Supermarket short redirect" stopProcessing="true">
          <match url="^supermarket-fridge-repair/?$" />
          <action type="Redirect" url="/supermarket-fridge-repair-london.html" redirectType="Permanent" />
        </rule>
        <rule name="Pass through PHP" stopProcessing="true">
          <match url="\.php$" ignoreCase="true" />
          <action type="None" />
        </rule>
        <rule name="Redirect index.asp to home" stopProcessing="true">
          <match url="^index\.asp$" ignoreCase="true" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="Redirect ASP to HTML when HTML exists" stopProcessing="true">
          <match url="^(.+)\.asp$" ignoreCase="true" />
          <conditions>
            <add input="{APPL_PHYSICAL_PATH}{R:1}.html" matchType="IsFile" />
          </conditions>
          <action type="Redirect" url="/{R:1}.html" redirectType="Permanent" />
        </rule>
        <rule name="GSC junk URL 301s" stopProcessing="true">
          <match url="^(.+?)/?$" ignoreCase="true" />
          <conditions>
            <add input="{GscJunkRedirects:{R:1}}" pattern="(.+)" />
          </conditions>
          <action type="Redirect" url="https://www.colddirect.co.uk{C:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Fix fridge-freezer-repairs-london 404" stopProcessing="true">
          <match url="^fridge-freezer-repairs-london(\.html)?/?$" />
          <action type="Redirect" url="https://www.colddirect.co.uk/" redirectType="Permanent" />
        </rule>
        <rule name="Keep Google verification HTML" stopProcessing="true">
          <match url="^google[0-9a-z]+\.html$" ignoreCase="true" />
          <action type="None" />
        </rule>
        <rule name="Redirect root index.html to /" stopProcessing="true">
          <match url="^index\.html$" ignoreCase="true" />
          <conditions>
            <add input="{THE_REQUEST}" pattern="^[A-Z]+\s/index\.html" />
          </conditions>
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="Redirect nested index.html to folder" stopProcessing="true">
          <match url="^(.+)/index\.html$" ignoreCase="true" />
          <conditions>
            <add input="{THE_REQUEST}" pattern="^[A-Z]+\s/.+/index\.html" />
          </conditions>
          <action type="Redirect" url="/{R:1}/" redirectType="Permanent" />
        </rule>
        <rule name="Prefer HTML over folder or ASP" stopProcessing="true">
          <match url="^(.+?)/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{APPL_PHYSICAL_PATH}{R:1}.html" matchType="IsFile" />
            <add input="{REQUEST_URI}" pattern="\.(xml|txt|php|js|css|webp|jpg|png|ico|svg)$" negate="true" ignoreCase="true" />
          </conditions>
          <action type="Rewrite" url="/{R:1}.html" />
        </rule>
        <rule name="ASP Extensionless fallback" stopProcessing="true">
          <match url="^(.+?)/?$" ignoreCase="true" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{APPL_PHYSICAL_PATH}{R:1}.asp" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="/{R:1}.asp" />
        </rule>
      </rules>
    </rewrite>
    <handlers>
      <remove name="ASPClassic" />
      <add name="ASPClassic" path="*.asp" verb="GET,HEAD,POST" modules="IsapiModule" scriptProcessor="%windir%\system32\inetsrv\asp.dll" resourceType="File" requireAccess="Script" />
    </handlers>
    <security>
      <requestFiltering>
        <fileExtensions>
          <remove fileExtension=".asp" />
          <add fileExtension=".asp" allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
