RewriteRule ^commercial-freezer-repairs-london(/|\.html|\.asp)?$ /commercial-freezer-repair-london/ [R=301,L]
# NOTE: /ice-machine-repairs-london/ is a LIVE indexed page (own folder, sitemap URL, title owned by auto-seo.aspx): it is NOT redirected.
RewriteRule ^ice-cream-maker-repairs?-london(/|\.html|\.asp)?$ /ice-cream-machine-repair-london/ [R=301,L]
RewriteRule ^wine-cooler-repairs-london(/|\.html|\.asp)?$ /wine-cooler-repair-london/ [R=301,L]
