<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Core / nav ---
RewriteRule ^about/?$ /about-us.html [R=301,L]
RewriteRule ^about-us/?$ /about-us.html [R=301,L]
RewriteRule ^contact/?$ /contact.html [R=301,L]
RewriteRule ^contact-us/?$ /contact.html [R=301,L]
RewriteRule ^book-a-repair-page/?$ /contact.html [R=301,L]
RewriteRule ^services/?$ / [R=301,L]

# Live blog (do not 301 these). Unknown old slugs still go home.
RewriteRule ^blog/?$ /blog/index.html [L]
RewriteRule ^blog/index\.html$ - [L]
RewriteRule ^blog/commercial-freezer-ice-buildup-causes/?$ /blog/commercial-freezer-ice-buildup-causes/index.html [L]
RewriteRule ^blog/cold-room-temperature-fluctuation/?$ /blog/cold-room-temperature-fluctuation/index.html [L]
RewriteRule ^blog/commercial-fridge-repair-cost-london/?$ /blog/commercial-fridge-repair-cost-london/index.html [L]
RewriteRule ^blog/?(.*)$ / [R=301,L]

# --- Old ranking service URLs ---
RewriteRule ^fridge-repairs-london/?$ /fridge-repair-london.html [R=301,L]
RewriteRule ^fridge-repairs-london\.html$ /fridge-repair-london.html [R=301,L]
RewriteRule ^freezer-repairs-london/?$ /freezer-repair-london.html [R=301,L]
RewriteRule ^freezer-repairs-london\.html$ /freezer-repair-london.html [R=301,L]
RewriteRule ^cold-room-repairs-london/?$ /cold-room-repair-north-london.html [R=301,L]
RewriteRule ^cold-room-repairs-london\.html$ /cold-room-repair-north-london.html [R=301,L]
RewriteRule ^commercial-cold-room-repair-london\.html$ /cold-room-repair-north-london.html [R=301,L]
RewriteRule ^walk-in-cold-room-repair-london/?$ /cold-room-repair-north-london.html [R=301,L]
RewriteRule ^walk-in-fridge-repairs-london/?$ /cold-room-repair-north-london.html [R=301,L]
RewriteRule ^freezer-room-repairs-london/?$ /freezer-room-repair-north-london.html [R=301,L]
RewriteRule ^commercial-freezer-repairs-london/?$ /commercial-freezer-repair-north-london.html [R=301,L]
RewriteRule ^commercial-fridge-repairs-london/?$ /commercial-fridge-repair-north-london.html [R=301,L]
RewriteRule ^commercial-fridge-repair-london\.html$ /commercial-fridge-repair-north-london.html [R=301,L]
RewriteRule ^display-fridge-repairs-london/?$ /display-cabinet-repair-north-london.html [R=301,L]
RewriteRule ^chiller-repairs-london/?$ /commercial-fridge-repair-north-london.html [R=301,L]
RewriteRule ^ice-machine-repairs-london/?$ /ice-machine-repair-london.html [R=301,L]
RewriteRule ^wine-cooler-repairs-london/?$ /wine-cooler-repair-london.html [R=301,L]
RewriteRule ^bottle-cooler-repairs-london/?$ /bottle-cooler-repair-london.html [R=301,L]
RewriteRule ^cellar-cooler-repairs-london/?$ /cellar-cooler-repair-london.html [R=301,L]
RewriteRule ^air-conditioning-repairs-london/?$ / [R=301,L]
RewriteRule ^air-conditioning-london\.html$ / [R=301,L]
RewriteRule ^air-conditioning/?$ / [R=301,L]
RewriteRule ^dishwashers-london/?$ / [R=301,L]
RewriteRule ^commercial-appliance-repairs-london/?$ /commercial-fridge-repair-north-london.html [R=301,L]
RewriteRule ^[Ee]mergency-fridge-repair-london\.html$ /fridge-repair-london.html [R=301,L]

# --- Brand / doorway pages indexed by Google ---
RewriteRule ^foster-fridge-repair-london/?$ /commercial-fridge-repair-north-london.html [R=301,L]
RewriteRule ^foster-fridge-repair-london\.html$ /commercial-fridge-repair-north-london.html [R=301,L]
RewriteRule ^foster-repairs-london/?$ /commercial-fridge-repair-north-london.html [R=301,L]
