RewriteRule ^blog/prevent-commercial-fridge-breakdown/?$ /blog/prevent-commercial-fridge-breakdown.html [L]
# Unknown blog slugs answer a real 404 (no soft-404 redirect to the homepage); mirrors web.config (IIS 404).
RewriteRule ^blog/.+$ - [R=404,L]

# Pretty URLs: /slug/ and /slug serve slug.html when that file exists (nginx often 404s these).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# Ice-O-Matic alias (page also exists as ice-o-matic-fridge-repairs.html)
RewriteRule ^ice-o-matic-fridge-repairs/?$ /ice-o-matic-fridge-repairs.html [L]

