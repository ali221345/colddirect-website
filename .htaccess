RewriteRule ^zanussi-fridge-repairs-london/?$ /commercial-fridge-repair-north-london.html [R=301,L]
RewriteRule ^prodis-repairs-london/?$ /commercial-fridge-repair-north-london.html [R=301,L]
RewriteRule ^prodis-fridge-repairs-london/?$ /commercial-fridge-repair-north-london.html [R=301,L]
