# Generic .html -> slash canonical. Keep BELOW every specific .html rule above so a specific target wins (one hop).
# The pass-through exclusions (google*.html, index.html, services/, liebherr, brands, repair-cost article) sit near the top.
# <dir>/index.html -> <dir>/ (never /<dir>/index/ which is a 404). Mirrors web.config "htaccess parity" rules.
RewriteRule ^(.+)/index\.html$ /$1/ [R=301,L]
RewriteRule ^(.*)\.html$ /$1/ [R=301,L]

# WordPress / PHP fallback (only if no file or directory)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress
