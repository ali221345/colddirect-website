# One-hop plural → slash canonical (must sit before generic .html → slash)
RewriteRule ^cold-room-repairs-london(/|\.html|\.asp)?$ /cold-room-repair-london/ [R=301,L]
RewriteRule ^fridge-repairs-london(/|\.html|\.asp)?$ /fridge-repair-london/ [R=301,L]
