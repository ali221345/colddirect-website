RewriteRule ^hoshizaki-repairs-london(/|\.html|\.asp)?$ /hoshizaki-ice-machine-repair-london/ [R=301,L]
RewriteRule ^liebherr-repairs-london(/|\.html|\.asp)?$ /liebherr-fridge-repair-london/ [R=301,L]
RewriteRule ^sub-zero-repairs-london(/|\.html|\.asp)?$ /subzero-fridge-repair-london/ [R=301,L]
RewriteRule ^subzero-repairs-london(/|\.html|\.asp)?$ /subzero-fridge-repair-london/ [R=301,L]
RewriteRule ^(atosa|zanussi|zanussi-fridge|prodis|prodis-fridge|gastroline|gastroline-fridge|koldbox|inomak|graupel|lynkso)-repairs-london(/|\.html|\.asp)?$ /commercial-fridge-repair-london/ [R=301,L]
RewriteRule ^(amana|midea|whirlpool|miele|maytag|samsung|smeg)-repairs-london(/|\.html|\.asp)?$ /fridge-repair-london/ [R=301,L]
RewriteRule ^mafirol-repairs-london(/|\.html|\.asp)?$ /display-fridge-repair-london/ [R=301,L]

# Short aliases first (one hop), then generic .html -> slash
RewriteRule ^ice-cream-machine-repair(\.html)?/?$ /ice-cream-machine-repair-london/ [R=301,L]
RewriteRule ^ice-machine-repair(\.html)?/?$ /ice-machine-repair-london/ [R=301,L]
RewriteRule ^google[0-9a-z]+\.html$ - [L]
RewriteRule ^index\.html$ / [R=301,L]
# Keep the Services directory index out of the generic HTML redirect.
RewriteRule ^services/index\.html$ - [L]
# Preserve the restored Liebherr directory index.
RewriteRule ^liebherr-fridge-repair-london/index\.html$ - [L]
# Keep the brands directory index out of the generic HTML redirect.
RewriteRule ^refrigeration-brands-repair-london/index\.html$ - [L]
# Serve the repair-cost article at its existing slash canonical without a loop.
RewriteRule ^blog/commercial-fridge-repair-cost-london\.html$ - [L]
RewriteRule ^blog/commercial-fridge-repair-cost-london$ /blog/commercial-fridge-repair-cost-london/ [R=301,L]
RewriteRule ^blog/commercial-fridge-repair-cost-london/$ /blog/commercial-fridge-repair-cost-london.html [L]
# Legacy news is an alias of the existing blog, not a separate article.
RewriteRule ^news(?:/index\.html|/|\.html)?$ https://www.colddirect.co.uk/blog/ [R=301,L]
# Retired blog stubs: ONE hop straight to the target (mirrors web.config; must stay above the generic .html rule).
RewriteRule ^blog/smeg-fridge-freezer-control-panel(\.html|/index\.html)$ /commercial-fridge-repair-london/ [R=301,L]
RewriteRule ^blog/samsung-fridge-freezer-not-freezing(\.html|/index\.html)$ /commercial-freezer-repair-london/ [R=301,L]
RewriteRule ^blog/best-ice-cream-makers(\.html|/index\.html)$ /ice-cream-machine-repair-london/ [R=301,L]
RewriteRule ^blog/cold-room-troubleshooting(\.html|/index\.html)$ /blog/cold-room-temperature-fluctuation/ [R=301,L]
RewriteRule ^blog/chiller-not-cooling(\.html|/index\.html)$ /chiller-repair-london/ [R=301,L]
# Live blog posts: .html and /index.html variants go ONE hop to the slash canonical (never /blog/index/, a 404).
RewriteRule ^blog/index\.html$ /blog/ [R=301,L]
RewriteRule ^blog/([^/]+)\.html$ /blog/$1/ [R=301,L]
RewriteRule ^blog/([^/]+)/index\.html$ /blog/$1/ [R=301,L]
# All other .html -> slash is the generic rule near the end of this file (below every specific .html rule).

RewriteRule ^ice-cream-machine-repairs-london/?$ /ice-cream-machine-repair-london/ [R=301,L]
RewriteRule ^ice-cream-repair-london/?$ /ice-cream-machine-repair-london/ [R=301,L]
RewriteRule ^icecream-machine-repair-london/?$ /ice-cream-machine-repair-london/ [R=301,L]
RedirectMatch 301 ^/ice-cream-machine-repair-london.html$ /ice-cream-machine-repair-london/
RedirectMatch 301 ^/ice-machine-repair-london.html$ /ice-machine-repair-london/
RedirectMatch 301 ^/catering-repair-london.html$ /catering-repair-london/
RedirectMatch 301 ^/freezer-repair-london.html$ /freezer-repair-london/
RedirectMatch 301 ^/fridge-repair-london.html$ /fridge-repair-london/

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Repair only public aliases confirmed as 404 by the internal-link audit.
RewriteRule ^appliances-repair-london$ /appliances-repair-london/ [R=301,L]
RewriteRule ^catering-repair-london$ /catering-repair-london/ [R=301,L]
RewriteRule ^chiller-repair-london$ /chiller-repair-london/ [R=301,L]
RewriteRule ^bottle-cooler-repair$ /bottle-cooler-repair-london/ [R=301,L]
RewriteRule ^display-fridge-repair$ /display-fridge-repair-london/ [R=301,L]

# Extensionless money/brand hubs: the bare slug is NOT canonical, so send it to the slash
# folder before the generic pretty-URL rule below serves slug.html with a 200.
RewriteRule ^fridge-repair-london$ /fridge-repair-london/ [R=301,L]
RewriteRule ^freezer-repair-london$ /freezer-repair-london/ [R=301,L]
RewriteRule ^williams-fridge-repair-london$ /williams-fridge-repair-london/ [R=301,L]

# Canonical directories: bare slug -> trailing-slash folder, ONE hop.
# Explicit list of the 102 directory slugs whose bare URL answered HTTP 200.
# No optional slash in the pattern, so /slug/ still serves the folder index.
# Legacy aliases (walk-in-cold-room-repair-london and the other plural/short
# redirects) are not in this list and keep their own single-hop targets.
