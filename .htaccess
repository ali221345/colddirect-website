RewriteRule ^gastroline-fridge-repairs-london/?$ /commercial-fridge-repair-north-london.html [R=301,L]
RewriteRule ^koldbox-repairs-london/?$ /commercial-fridge-repair-north-london.html [R=301,L]
RewriteRule ^inomak-repairs-london/?$ /commercial-fridge-repair-north-london.html [R=301,L]
RewriteRule ^gram-repairs-london/?$ /commercial-fridge-repair-north-london.html [R=301,L]
RewriteRule ^garm-repairs-london/?$ /commercial-fridge-repair-north-london.html [R=301,L]
RewriteRule ^mafirol-repairs-london/?$ /display-cabinet-repair-north-london.html [R=301,L]
