{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/api/(.*)",
      "has": [{ "type": "header", "key": "Origin", "value": "https://www.colddirect.co.uk" }],
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://www.colddirect.co.uk" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, X-CD-IP, Accept" },
        { "key": "Access-Control-Allow-Credentials", "value": "false" },
        { "key": "Vary", "value": "Origin" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/(.*)",
      "has": [{ "type": "header", "key": "Origin", "value": "https://colddirect.co.uk" }],
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://colddirect.co.uk" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, X-CD-IP, Accept" },
        { "key": "Access-Control-Allow-Credentials", "value": "false" },
        { "key": "Vary", "value": "Origin" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "functions": {
    "api/voice-diagnose.js": { "maxDuration": 60 },
    "api/voice-tts.js": { "maxDuration": 30 },
    "api/ping.js": { "maxDuration": 10 }
  }
}
