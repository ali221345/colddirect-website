<script>
(function(){
  document.querySelectorAll('.has-mega-menu > a').forEach(function(link){
    link.addEventListener('click', function(e){
      e.preventDefault();
      var mega = this.nextElementSibling;
      var isOpen = mega.classList.contains('open');
      document.querySelectorAll('.mega-menu.open').forEach(function(m){ m.classList.remove('open'); });
      if(!isOpen) mega.classList.add('open');
    });
  });
  document.addEventListener('click', function(e){
    if(!e.target.closest('.has-mega-menu')){
      document.querySelectorAll('.mega-menu.open').forEach(function(m){ m.classList.remove('open'); });
    }
    var item = e.target.closest('.cd-nav .has-dropdown');
    if(item && item.classList.contains('has-mega-menu')) return;
    var toggle = item && e.target.closest('a') && e.target.closest('a').parentElement === item;
    if(toggle && window.matchMedia('(max-width:1099px)').matches){
      e.preventDefault();
      var willOpen = !item.classList.contains('open');
      document.querySelectorAll('.cd-nav .has-dropdown.open').forEach(function(el){
        if(el !== item) el.classList.remove('open');
      });
      item.classList.toggle('open', willOpen);
      return;
    }
    if(!item){
      document.querySelectorAll('.cd-nav .has-dropdown.open').forEach(function(el){ el.classList.remove('open'); });
    }
  });
})();
</script>
