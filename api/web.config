<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="X-CD-IP" value="CD-UK-IP-2026-994821-VOICE-AI" />
      </customHeaders>
    </httpProtocol>
    <security>
